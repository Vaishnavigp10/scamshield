# Copy to .env (optional for local runs)
SECRET_KEY=change-me
DEBUG=1
# EVENT_ASYNC=1 processes events on a background thread pool (queue-like behaviour)
EVENT_ASYNC=0
API_RATE_LIMIT_PER_MIN=60
# Optional cloud hooks (AWS). Leave empty to run fully self-contained.
AWS_SQS_QUEUE_URL=
AWS_REGION=ap-south-1
